<?xml version="1.0"?>
<!-- ros2_control 硬件接口配置文件 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="panda_arm_ros2_control" params="name initial_positions_file motor_params_file serial_port
              motor_id_joint1 motor_id_joint2 motor_id_joint3 motor_id_joint4
              motor_id_joint5 motor_id_joint6 motor_id_joint7">
        <!-- 以上参数值来自panda_arm.urdf.xacro -->
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:property name="motor_params" value="${xacro.load_yaml(motor_params_file)}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>panda_arm_hardware/PandaArmHardware</plugin>
                <param name="serial_port">${serial_port}</param>
            </hardware>
            <joint name="joint_1">
                <param name="motor_id">${motor_id_joint1}</param>
                <param name="kp">${motor_params['kp']['joint_1']}</param>
                <param name="kd">${motor_params['kd']['joint_1']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_1']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_2">
                <param name="motor_id">${motor_id_joint2}</param>
                <param name="kp">${motor_params['kp']['joint_2']}</param>
                <param name="kd">${motor_params['kd']['joint_2']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_2']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_3">
                <param name="motor_id">${motor_id_joint3}</param>
                <param name="kp">${motor_params['kp']['joint_3']}</param>
                <param name="kd">${motor_params['kd']['joint_3']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_3']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_4">
                <param name="motor_id">${motor_id_joint4}</param>
                <param name="kp">${motor_params['kp']['joint_4']}</param>
                <param name="kd">${motor_params['kd']['joint_4']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_4']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_5">
                <param name="motor_id">${motor_id_joint5}</param>
                <param name="kp">${motor_params['kp']['joint_5']}</param>
                <param name="kd">${motor_params['kd']['joint_5']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_5']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_6">
                <param name="motor_id">${motor_id_joint6}</param>
                <param name="kp">${motor_params['kp']['joint_6']}</param>
                <param name="kd">${motor_params['kd']['joint_6']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_6']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="joint_7">
                <param name="motor_id">${motor_id_joint7}</param>
                <param name="kp">${motor_params['kp']['joint_7']}</param>
                <param name="kd">${motor_params['kd']['joint_7']}</param>
                <param name="zero_offset">${motor_params['zero_offsets']['joint_7']}</param>
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <command_interface name="effort"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_7']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
