<?xml version="1.0"?>
<!--
  ros2_control 硬件接口配置文件
  仿真使用的参数（Gazebo Classic 11）。实物和仿真同一个控制器，但是控制器配置不同

  与实物 config/panda_arm.ros2_control.xacro 的差别只有两点：
    1. <plugin> 换成 gazebo_ros2_control/GazeboSystem （Gazebo 自带的硬件接口实现）
    2. 每个关节只声明 effort 命令接口， 目的是模拟电机的力位混合控制算法
    3.kp/kd 由 config/sim_controllers.yaml 直接给控制器（仿真里没有电机板）。

  <plugin libgazebo_ros2_control.so> 在panda_arm.gazebo 执行，含义是启动 controller_manager
  实物的 controller_manager 在launch里启动
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 单个关节的接口声明：仿真里只有 effort 命令接口 -->
    <xacro:macro name="sim_joint_interfaces" params="jname">
        <joint name="${jname}">
            <command_interface name="effort"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="panda_arm_sim_ros2_control" params="name">
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>

            <xacro:sim_joint_interfaces jname="joint_1"/>
            <xacro:sim_joint_interfaces jname="joint_2"/>
            <xacro:sim_joint_interfaces jname="joint_3"/>
            <xacro:sim_joint_interfaces jname="joint_4"/>
            <xacro:sim_joint_interfaces jname="joint_5"/>
            <xacro:sim_joint_interfaces jname="joint_6"/>
            <xacro:sim_joint_interfaces jname="joint_7"/>

        </ros2_control>
    </xacro:macro>

</robot>
